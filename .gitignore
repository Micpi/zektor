# Ignore tout par defaut
*

# Garder ce fichier et le workflow de release auto
!.gitignore
!AGENTS.md
!.github/
!.github/copilot-instructions.md
!.github/workflows/
!.github/workflows/**
!.vscode/
!.vscode/tasks.json

# Documentation et scripts
!docs/
!docs/**
!scripts/
!scripts/**
!tests/
tests/*
!tests/nad_avr/
!tests/nad_avr/**

# Metadata et loader HACS (root repository files)
!hacs.json
!homeassistant-ai-cards.js
!README.md
!README_WORKSPACE_CATALOG.md
!PROJECT_CONTEXT.md

# Autoriser uniquement les cartes et integrations HA
# NB: custom_components/ (racine) a ete retire le 2026-07-26 - il dupliquait
# integrations/ avec un contenu qui avait diverge. Source de verite = integrations/.
# Voir _archive/custom_components_root_backup_2026-07-26/NOTE.md
!custom_cards/
!custom_cards/**
!integrations/
!integrations/**

# Exclusions locales dans le scope autorise
custom_cards/**/node_modules/
custom_cards/**/*.log
custom_cards/**/.npm/
tests/**/__pycache__/
tests/**/.pytest_cache/
integrations/**/__pycache__/
integrations/**/.pytest_cache/

# HA secrets (defense en profondeur)
**/secrets.yaml
**/.storage/
